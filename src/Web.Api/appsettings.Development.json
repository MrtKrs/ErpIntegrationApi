{
  "ConnectionStrings": {
    "Database": "Server=PLACEHOLDER;Database=PLACEHOLDER;User Id=PLACEHOLDER;Password=PLACEHOLDER;",
    "Telemetry": "Host=localhost;Port=5432;Database=telemetry;Username=postgres;Password=postgres;Include Error Detail=true"

  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.OpenTelemetry"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "endpoint": "http://localhost:4317",
          "protocol": "Grpc",
          "resourceAttributes": {
            "service.name": "Web.Api"
          }
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Jwt": {
    "Secret": "super-duper-secret-value-that-should-be-in-user-secrets",
    "Issuer": "clean-architecture",
    "Audience": "developers",
    "ExpirationInMinutes": 60
  }
}
